# Paemisyon 2.0 mobil — yalnız EXPO_PUBLIC_* değerler pakete gömülür, hiçbiri gizli değildir.
# .env.local olarak kopyala. Service role / sb_secret_ anahtarı bu dosyaya ASLA girmez.

EXPO_PUBLIC_API_BASE_URL=https://api.paemisyon.com/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://yhkiuzevyqdqtofrmroj.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google ile giriş (Supabase'in Google sağlayıcısındaki Client IDs listesinde olmalı)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Sentry (boşsa SDK pasif)
EXPO_PUBLIC_SENTRY_DSN=

# EAS (isteğe bağlı; app.config.ts)
EAS_PROJECT_ID=
