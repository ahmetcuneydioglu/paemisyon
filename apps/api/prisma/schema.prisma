// Paemisyon — Prisma şeması
// Kaynak: docs/06-database-design.md
// İlke: içerik sürümlenir (silinmez), iş verisi ilişkiseldir, modül-agnostik çekirdek.
// Not: UUID için Postgres gen_random_uuid() (v4). İleride UUIDv7 uzantısına geçilebilir.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooler (uygulama sorguları)
  directUrl = env("DIRECT_URL") // doğrudan bağlantı (migration için)
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserStatus {
  active
  suspended
  deleted
}

enum AuthProvider {
  email
  apple
  google
}

enum ContentStatus {
  draft
  in_review
  published
  archived
}

/// Konu özeti kart türleri (Doc 53 §3).
enum SummaryBlockType {
  concept
  rule
  numbers
  compare
  trap
  exam_stats
  bridge
}

/// Mevzuat türü (Doc 29 §11) — V1'de yalnız `kanun` dolu; mimari geleceğe açık.
enum LegislationType {
  kanun
  cbk
  yonetmelik
  genelge
  yonerge
}

enum Difficulty {
  easy
  medium
  hard
}

enum PlanPeriod {
  none
  monthly
  quarterly // 3 aylık — web'in tek satılabilir planı (manuel ödeme)
  yearly
  lifetime // ömürlük — tek seferlik satın alma (App Store non-consumable), süresi yok
}

enum SubscriptionStatus {
  active
  expired
  grace
  cancelled
  refunded
}

enum PaymentProvider {
  apple
  google
  manual
}

enum LegacySource {
  ios_firebase
  web_mysql
}

enum QuizMode {
  practice
  exam
  daily
  review
  deneme // randevulu canlı deneme (Doc 18)
}

enum QuizSessionStatus {
  in_progress
  completed
  abandoned
}

/// Denemeler V2 (Doc 50 §2): yayın biçimi. serbest = tarih bağımsız, aday
/// istediği zaman çözer; takvimli = açılış saati var, pencere kapanınca sıralama donar.
enum ExamPublishMode {
  serbest
  takvimli
}

enum ExamDifficulty {
  kolay
  orta
  zor
}

/// Deneme çözümünün rolü (Doc 50 §2.2): official = sıralamaya giren tek resmî
/// çözüm; practice = tekrar çözüm (sıralamaya girmez, tekrarlanabilir).
enum AttemptRole {
  official
  practice
}

/// Oturum nasıl kapandı: aday teslim etti ya da süre doldu (Doc 50 §3).
enum SessionClosedReason {
  submitted
  timeout
}

/// Soru iptali (Doc 50 §2.3): herkese doğru say (varsayılan) ya da hesaptan çıkar.
enum ExamAdjustmentAction {
  credit_all
  exclude
}

enum ExamReminderKind {
  day_before
  hour_before
  result_ready
}

// ─────────────────────────────────────────────
// Identity & Access
// ─────────────────────────────────────────────

model User {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String     @unique
  emailVerifiedAt       DateTime?  @map("email_verified_at")
  displayName           String     @map("display_name")
  avatarUrl             String?    @map("avatar_url")
  status                UserStatus @default(active)
  onboardingCompletedAt DateTime?  @map("onboarding_completed_at")
  // Hedef sınav (onboarding'de seçilir; Home/katalog varsayılanı — Doc 11 §2).
  preferredModuleId     String?    @map("preferred_module_id") @db.Uuid
  // Günlük soru hedefi (koç hero halkası — Doc 19 §3.2). Kullanıcı ayarlayabilir.
  dailyGoal             Int        @default(20) @map("daily_goal")
  /// Günlük çalışma süresi hedefi, dakika (Doc 49 S1-D): onboarding'in 15/30/60
  /// seçimi; `dailyGoal` soru hedefi AYRI anlamdır ve kalır. null = seçilmedi.
  dailyMinutes          Int?       @map("daily_minutes")
  // Hedef sınav tarihi (Doc 25 §3 durum makinesi: exam_mode/taper). Kullanıcı ayarlar.
  targetExamDate        DateTime?  @map("target_exam_date") @db.Date
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  deletedAt             DateTime?  @map("deleted_at")

  authIdentities    AuthIdentity[]
  roles             UserRole[]
  entitlement       Entitlement?
  subscriptions     Subscription[]
  dailyUsage        DailyUsage[]
  quizSessions      QuizSession[]
  examRankings      ExamRanking[]
  examReminders     ExamReminder[]
  topicProgress     UserTopicProgress[]
  stats             UserStats?
  streak            Streak?
  bookmarks         Bookmark[]
  articleBookmarks  ArticleBookmark[]
  articleHighlights ArticleHighlight[]
  articleNotes      ArticleNote[]
  readingProgress   ReadingProgress[]
  summaryProgress   SummaryProgress[]
  wrongAnswers      WrongAnswer[]
  questionReviews   QuestionReview[]
  questionNotes     QuestionNote[]
  lists             UserList[]
  studyPlans        StudyPlan[]
  questionReports   QuestionReport[]
  badges            UserBadge[]
  masterySnapshots  TopicMasterySnapshot[]
  pushTokens        PushToken[]
  emailContacts     EmailContact[]
  dailyFocus        DailyFocus?
  preferredModule   ExamType?              @relation(fields: [preferredModuleId], references: [id])

  @@map("users")
}

/// FCM cihaz token'ı (Faz 2 push). Token cihaza aittir: aynı cihazda hesap
/// değişirse upsert userId'yi taşır — eski hesaba bu cihazdan push gitmez.
/// KVKK: hesap silinince cascade ile token da silinir.
model PushToken {
  token     String   @id
  userId    String   @map("user_id") @db.Uuid
  platform  String // 'ios' | 'android'
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model AuthIdentity {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  provider    AuthProvider
  providerUid String       @map("provider_uid")
  createdAt   DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
  @@map("auth_identities")
}

model Role {
  id    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key   String     @unique // admin | editor | user | beta (Doc 48 ön erişim)
  name  String
  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ─────────────────────────────────────────────
// Content (sürümlü) — Modül → Ders → Konu → Soru
// ─────────────────────────────────────────────

/// Sınav Türü (Doc 21) — PAEM, Misyon, ileride Başkomiserlik…
/// Yeni sınav türü eklemek = SATIR eklemek (şema değişikliği değil).
/// Tablo adı geriye uyum için "modules" kaldı (veri migration'ı gerektirmez).
model ExamType {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String    @unique // paem, misyon, pomem...
  name        String
  description String?
  icon        String?
  sortOrder   Int       @default(0) @map("sort_order")
  /// Resmî sınav tarihi (Doc 48 A2). Kullanıcının kişisel tarihi varsa o geçerli;
  /// açıklanmamışsa NULL. Panelden (İçerik Ağacı) girilir.
  examDate    DateTime? @map("exam_date") @db.Date
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sections       ExamSection[]
  preferredUsers User[]
  studyPlans     StudyPlan[]
  exams          Exam[]

  @@map("modules")
}

/// Müfredat bölümü (Doc 21 §2): sınav türünde KULLANICIYA GÖRÜNEN ders başlığı.
/// İçerik dersi (Course) küreseldir; bölüm başlık + ağırlık + sırayı taşır.
/// Örn. Misyon "Anayasa ve İdare Hukuku" (%10) → 2 içerik dersine bağlanır.
model ExamSection {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examTypeId    String    @map("exam_type_id") @db.Uuid
  name          String
  /// Sınavdaki ağırlık (PAEM Genel Kültür %30…) — deneme üretimi bunu kullanır.
  weightPercent Int       @default(0) @map("weight_percent")
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  examType ExamType            @relation(fields: [examTypeId], references: [id])
  courses  ExamSectionCourse[]

  @@index([examTypeId])
  @@map("exam_sections")
}

/// Bölüm ↔ içerik dersi bağlantısı (N:N) — veri tekrarı olmadan paylaşım.
model ExamSectionCourse {
  sectionId String @map("section_id") @db.Uuid
  courseId  String @map("course_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  course  Course      @relation(fields: [courseId], references: [id])

  @@id([sectionId, courseId])
  @@index([courseId])
  @@map("exam_section_courses")
}

/// Admin/editor işlemlerinin izi (Doc 9 §6) — kim, neyi, ne zaman.
/// Eski sistemdeki "ekip_loglar" fikrinin sağlıklı hali; panel salt-okur gösterir.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorEmail String   @map("actor_email")
  action     String // örn: question.create, question.approve, user.suspend
  entityType String   @map("entity_type") // question | course | topic | user | plan...
  entityId   String?  @map("entity_id")
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// İçerik dersi (Doc 21) — KÜRESEL havuz: sınav türüne gömülü değil; müfredat
/// bölümleri (ExamSection) üzerinden bir veya birden çok sınava bağlanır.
model Course {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  /// Dersin ikonu (Doc 48 Faz 6.3): Lucide anahtarı ("scale", "shield"…); izinli
  /// liste `src/common/course-icons.ts`. NULL'da istemci açık kitap çizer.
  /// Panelden (İçerik Ağacı) değiştirilir.
  icon      String?
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  sections     ExamSectionCourse[]
  topics       Topic[]
  quizSessions QuizSession[]
  dailyFocuses DailyFocus[]

  @@map("courses")
}

/// Konu — SELF-REFERENCING AĞAÇ (Doc 21): parentId null = Konu, dolu = Alt
/// Konu. Derinlik esnek; ileri seviye eklemek şema değişikliği gerektirmez.
/// Sorular herhangi bir düğüme (tipik yaprak) bağlanır; mastery/koç/snapshot/
/// matchKeywords topicId bazlı olduğundan hiçbiri etkilenmez.
model Topic {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId      String    @map("course_id") @db.Uuid
  parentId      String?   @map("parent_id") @db.Uuid
  name          String
  sortOrder     Int       @default(0) @map("sort_order")
  isPremium     Boolean   @default(false) @map("is_premium")
  // Toplu içe aktarmada soruyu bu konuya otomatik eşleyen desenler (Doc 20).
  // Örn. "657 Devlet Memurları Kanunu" → ["657 sayılı", "Devlet Memurları Kanunu"].
  // Taksonomi = eşleme tablosu: admin konuyu düzenleyerek yönetir.
  matchKeywords String[]  @map("match_keywords")
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  course           Course                 @relation(fields: [courseId], references: [id])
  parent           Topic?                 @relation("TopicTree", fields: [parentId], references: [id])
  children         Topic[]                @relation("TopicTree")
  questions        Question[]
  quizSessions     QuizSession[]
  userProgress     UserTopicProgress[]
  masterySnapshots TopicMasterySnapshot[]
  lawArticles      LawArticle[]
  legislation      Legislation?
  summaryUnits     SummaryUnit[]

  dailyFocuses DailyFocus[]

  studyPlanItems StudyPlanItem[]

  @@index([courseId])
  @@index([parentId])
  @@map("topics")
}

/// Resmî madde metni (Doc 25 §4 adım 3 — "kanun metni içerik hattı").
/// Kanun = Topic; madde = Question.articleNo etiketiyle AYNI kanonik biçim
/// ("16", "4/A", "Ek 6", "Geçici 2"). Böylece Madde Atlası'nda soru grubu ile
/// metin tek anahtarda (topicId, articleNo) buluşur.
///
/// İLKE (anayasa): metin AI ile ÜRETİLMEZ/ÖZETLENMEZ — birebir resmî metin;
/// kaynak (mevzuat.gov.tr) ve doğrulama tarihi her zaman görünür. Doğrulanmadan
/// (status=published) istemciye SIZMAZ; import taslak (draft) yazar, admin yayınlar.
model LawArticle {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId   String @map("topic_id") @db.Uuid
  articleNo String @map("article_no")
  /// Birebir resmî madde metni (fıkralar korunur; \n ile satırlar).
  text      String

  /// Kaynak künyesi — istemcide görünür (güven vaadi).
  sourceName     String    @default("mevzuat.gov.tr") @map("source_name")
  sourceUrl      String?   @map("source_url")
  /// Yürürlük/işlenme notu (ör. "5/7/2022 tarihli değişiklik işlenmiş metin").
  effectiveInfo  String?   @map("effective_info")
  /// İçeriğin resmî kaynağa göre son doğrulandığı an (istemcide "… itibarıyla").
  lastVerifiedAt DateTime? @map("last_verified_at")

  status ContentStatus @default(draft)

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ── Mevzuat Merkezi (Doc 29) ──
  /// Kanun kimliği — geçiş sonrası tüm maddelerde dolu; topicId quiz köprüsü
  /// için kalır (soru etiketi (topicId, articleNo) anahtarını kullanır).
  legislationId String?                  @map("legislation_id") @db.Uuid
  sectionId     String?                  @map("section_id") @db.Uuid
  /// Madde başlığı (ör. "Durdurma ve kimlik sorma") — resmî metinden; yoksa null.
  title         String?
  /// Deterministik sıra: articleOrder() kalıcılaştı (sayısal önce, Ek/Geçici sona).
  sortKey       Int                      @default(0) @map("sort_key")
  /// Tam-metin arama vektörü — migration'da GENERATED ALWAYS (simple + tr_unaccent).
  search        Unsupported("tsvector")?

  topic       Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  legislation Legislation?        @relation(fields: [legislationId], references: [id], onDelete: SetNull)
  section     LegislationSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  bookmarks   ArticleBookmark[]
  highlights  ArticleHighlight[]
  notes       ArticleNote[]
  questions   QuestionArticle[]
  versions    LawArticleVersion[]
  summaryRefs SummaryBlockArticle[]

  // Kanun başına madde tekil; import upsert bu anahtara dayanır.
  @@unique([topicId, articleNo])
  @@index([topicId, status])
  @@index([legislationId, sortKey])
  @@map("law_articles")
}

/// Mevzuat kimliği (Doc 29 §11) — kanun artık birinci sınıf varlık.
/// slug KALICIDIR: ad düzeltmeleri URL kırmaz (eski türetilmiş slugify yerine).
/// topicId opsiyonel 1:1 quiz köprüsü — sorusu olmayan mevzuat da yaşayabilir.
model Legislation {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String          @unique
  type              LegislationType @default(kanun)
  /// Resmî numara: "2559", "5271" — CBK/genelgede null olabilir.
  number            String?
  name              String
  /// Yaygın kısaltma: "PVSK", "CMK" — arama ve kompakt gösterim.
  shortName         String?         @map("short_name")
  /// Arama takma adları (normalize, küçük harf): ["pvsk","polis vazife"].
  aliases           String[]        @default([])
  officialSourceUrl String?         @map("official_source_url")
  effectiveInfo     String?         @map("effective_info")
  lastVerifiedAt    DateTime?       @map("last_verified_at")
  status            ContentStatus   @default(draft)
  sortOrder         Int             @default(0) @map("sort_order")
  topicId           String?         @unique @map("topic_id") @db.Uuid

  topic           Topic?               @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sections        LegislationSection[]
  articles        LawArticle[]
  readingProgress ReadingProgress[]
  summaryUnits    SummaryUnit[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([type, status, sortOrder])
  @@map("legislation")
}

/// Kısım/Bölüm hiyerarşisi — içindekiler bundan doğar. parentId ile
/// "Kısım > Bölüm" gibi iki (veya daha çok) seviye desteklenir.
model LegislationSection {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legislationId String  @map("legislation_id") @db.Uuid
  parentId      String? @map("parent_id") @db.Uuid
  heading       String
  sortOrder     Int     @default(0) @map("sort_order")

  legislation Legislation          @relation(fields: [legislationId], references: [id], onDelete: Cascade)
  parent      LegislationSection?  @relation("SectionTree", fields: [parentId], references: [id])
  children    LegislationSection[] @relation("SectionTree")
  articles    LawArticle[]

  @@index([legislationId, sortOrder])
  @@map("legislation_sections")
}

/// Madde favorisi (Doc 29 §14) — soru Bookmark'ının madde eşi.
model ArticleBookmark {
  userId       String   @map("user_id") @db.Uuid
  lawArticleId String   @map("law_article_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  article LawArticle @relation(fields: [lawArticleId], references: [id], onDelete: Cascade)

  @@id([userId, lawArticleId])
  @@map("article_bookmarks")
}

/// Madde işaretlemesi (Doc 29 §17 — P2): kullanıcının seçtiği metin parçası.
/// Çapa: karakter aralığı + parça metni (metin güncellenirse parça ile
/// yeniden konumlanır; bulunamazsa istemci sessizce gizler).
model ArticleHighlight {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  lawArticleId String   @map("law_article_id") @db.Uuid
  startOffset  Int      @map("start_offset")
  endOffset    Int      @map("end_offset")
  snippet      String
  createdAt    DateTime @default(now()) @map("created_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  article LawArticle @relation(fields: [lawArticleId], references: [id], onDelete: Cascade)

  @@index([userId, lawArticleId])
  @@map("article_highlights")
}

/// Kişisel madde notu (Doc 29 §18 — P2): madde başına TEK not (upsert).
/// Resmî metinden veri modelinde de ayrı — asla karışmaz (güven ilkesi).
model ArticleNote {
  userId       String   @map("user_id") @db.Uuid
  lawArticleId String   @map("law_article_id") @db.Uuid
  text         String
  updatedAt    DateTime @updatedAt @map("updated_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  article LawArticle @relation(fields: [lawArticleId], references: [id], onDelete: Cascade)

  @@id([userId, lawArticleId])
  @@map("article_notes")
}

/// Okuma konumu (Doc 29 §14) — "kaldığın yerden devam" + "son okunanlar".
/// Kanun başına tek satır; upsert ile güncellenir (web/mobil senkron).
model ReadingProgress {
  userId        String   @map("user_id") @db.Uuid
  legislationId String   @map("legislation_id") @db.Uuid
  articleNo     String   @map("article_no")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  legislation Legislation @relation(fields: [legislationId], references: [id], onDelete: Cascade)

  @@id([userId, legislationId])
  @@index([userId, updatedAt])
  @@map("reading_progress")
}

// ─────────────────────────────────────────────
// Konu Özetleri (Doc 53) — maddeye çivilenmiş kart dizisi
// ─────────────────────────────────────────────

/// Ünite: bir konuya ve bir mevzuata bağlı, 10–15 dk okunan sıralı kart paketi.
/// İLKE: üretim modeldir, yayın insanındır — ünite in_review doğar, admin yayınlar.
/// Kaynak etiketi ("AI özeti — …") yalnız admin'de görünür (4 Eyl 2026 kuralı).
model SummaryUnit {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId        String        @map("topic_id") @db.Uuid
  legislationId  String        @map("legislation_id") @db.Uuid
  /// KALICI: web URL'i (/ozet/<kanun>/<slug>) buna dayanır.
  slug           String        @unique
  title          String
  subtitle       String?
  /// Bilgi amaçlı madde aralığı ("75"–"86"); kartlar kendi referanslarını taşır.
  articleFrom    String        @map("article_from")
  articleTo      String        @map("article_to")
  sortOrder      Int           @default(0) @map("sort_order")
  /// Doc 53 karar 8: dersin ilk 2 ünitesi açık, kalanı premium.
  isPremium      Boolean       @default(false) @map("is_premium")
  readingMinutes Int           @default(10) @map("reading_minutes")
  status         ContentStatus @default(in_review)
  sourceLabel    String        @map("source_label")
  version        Int           @default(1)
  generatedBy    String?       @map("generated_by")
  publishedAt    DateTime?     @map("published_at")
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  topic       Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  legislation Legislation       @relation(fields: [legislationId], references: [id], onDelete: Cascade)
  blocks      SummaryBlock[]
  progress    SummaryProgress[]

  @@index([topicId, status, sortOrder])
  @@index([legislationId])
  @@map("summary_units")
}

/// Kart. body: markdown-lite (kalın, liste); rows: numbers/compare/exam_stats/bridge satırları
/// (`{label,value,refs}` ya da `{aspect,left,right,refs}`); derivedNumbers: metinde geçmeyen,
/// formülle türetilen sayılar; counterNumbers: kartın "yanlış şık" diye andığı sayılar.
/// staleSince: referans verdiği madde metni değiştiğinde dolar (eskime kuyruğu).
model SummaryBlock {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId         String           @map("unit_id") @db.Uuid
  type           SummaryBlockType
  title          String?
  body           String?
  rows           Json?
  derivedNumbers Json?            @map("derived_numbers")
  counterNumbers Int[]            @default([]) @map("counter_numbers")
  /// exam_stats/bridge: betik üretimi, insan düzenlemez.
  generated      Boolean          @default(false)
  sortOrder      Int              @default(0) @map("sort_order")
  status         ContentStatus    @default(in_review)
  staleSince     DateTime?        @map("stale_since")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  unit        SummaryUnit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  articleRefs SummaryBlockArticle[]

  @@index([unitId, sortOrder])
  @@index([staleSince])
  @@map("summary_blocks")
}

/// Kart → madde referansı. articleVersionNo: kartın yazıldığı anda maddenin sürümü;
/// madde değişince eskime kıyası buna dayanır.
model SummaryBlockArticle {
  blockId          String @map("block_id") @db.Uuid
  lawArticleId     String @map("law_article_id") @db.Uuid
  articleVersionNo Int?   @map("article_version_no")

  block      SummaryBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  lawArticle LawArticle   @relation(fields: [lawArticleId], references: [id], onDelete: Cascade)

  @@id([blockId, lawArticleId])
  @@index([lawArticleId])
  @@map("summary_block_articles")
}

/// Okuma ilerlemesi — ReadingProgress'in ünite eşi (kaldığın kart, bitirme).
model SummaryProgress {
  userId         String    @map("user_id") @db.Uuid
  unitId         String    @map("unit_id") @db.Uuid
  lastBlockIndex Int       @default(0) @map("last_block_index")
  completedAt    DateTime? @map("completed_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit SummaryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@index([userId, updatedAt])
  @@map("summary_progress")
}

// Kararlı KİMLİK — içerik burada değil, sürümlerde.
model Question {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId          String    @map("topic_id") @db.Uuid
  // Madde Atlası (Doc 25 §4): sorunun bağlı olduğu kanun maddesi ("16", "4/A",
  // "Ek 1", "Geçici 2"). Kanun = topic; madde bu etiketle çözülür. Import'ta
  // otomatik tespit edilir (detectArticleNo), elle düzeltilebilir.
  articleNo        String?   @map("article_no")
  currentVersionId String?   @unique @map("current_version_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  topic          Topic              @relation(fields: [topicId], references: [id])
  reports        QuestionReport[]
  versions       QuestionVersion[]  @relation("QuestionVersions")
  currentVersion QuestionVersion?   @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  examQuestions  ExamQuestion[]
  pastExams      PastExamQuestion[]
  reviews        QuestionReview[]
  articles       QuestionArticle[]
  userNotes      QuestionNote[]
  listItems      UserListItem[]

  @@index([topicId])
  @@index([topicId, articleNo])
  @@map("questions")
}

// İçerik burada — DEĞİŞMEZ sürümler.
model QuestionVersion {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId     String        @map("question_id") @db.Uuid
  versionNo      Int           @map("version_no")
  stem           String
  explanation    String?
  difficulty     Difficulty    @default(medium)
  mediaUrl       String?       @map("media_url")
  // Soru kaynağı (örn. "30 Kasım 2025 Adalet Bakanlığı GYS — Zabıt Kâtibi").
  // Kullanıcıya gösterimi app_settings.show_question_source ile açılır/kapanır.
  sourceLabel    String?       @map("source_label")
  // İçerik parmak izi (Doc 20 EK 2) — tekrar (mükerrer soru) tespiti.
  // sha256(normalize(kök) + sıralı şık metinleri). İçe aktarımda yazılır.
  contentHash    String?       @map("content_hash")
  status         ContentStatus @default(draft)
  authoredBy     String?       @map("authored_by") @db.Uuid
  reviewedBy     String?       @map("reviewed_by") @db.Uuid
  // Ret notu (Doc 49 A0): reddedilen sürümün üstünde durur, editöre panelde
  // gösterilir; yeniden incelemeye gönderilince temizlenir.
  reviewNote     String?       @map("review_note")
  /// Son insan incelemesi (Doc 49 S1-D): panel onayı/reddi ve tazeleme betikleri
  /// yazar; S2'de "6 aydır incelenmemiş" süzgeci.
  lastReviewedAt DateTime?     @map("last_reviewed_at")
  publishedAt    DateTime?     @map("published_at")
  archivedAt     DateTime?     @map("archived_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  question          Question         @relation("QuestionVersions", fields: [questionId], references: [id])
  currentOfQuestion Question?        @relation("CurrentVersion")
  options           QuestionOption[]
  legalReferences   LegalReference[]
  examQuestions     ExamQuestion[]

  @@unique([questionId, versionNo])
  @@index([questionId, status])
  @@index([contentHash])
  @@map("question_versions")
}

model QuestionOption {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionVersionId String  @map("question_version_id") @db.Uuid
  label             String // A, B, C, D, E
  text              String
  isCorrect         Boolean @default(false) @map("is_correct")
  sortOrder         Int     @default(0) @map("sort_order")

  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)

  @@index([questionVersionId])
  @@map("question_options")
}

model LegalReference {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionVersionId String    @map("question_version_id") @db.Uuid
  citation          String // örn. "2559 sayılı PVSK md. 4/A"
  url               String?
  effectiveDate     DateTime? @map("effective_date") @db.Date

  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)

  @@index([questionVersionId])
  @@map("legal_references")
}

// ─────────────────────────────────────────────
// Subscription & Monetization
// ─────────────────────────────────────────────

model Plan {
  id                     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                    String     @unique // free | quarterly | yearly | lifetime
  name                   String
  price                  Decimal?   @db.Decimal(10, 2)
  currency               String     @default("TRY")
  period                 PlanPeriod @default(none)
  dailyQuestionLimit     Int?       @map("daily_question_limit") // free için sınır; premium null=sınırsız
  /// Günde kaç kişisel deneme açılabilir (Doc 46); null = sınırsız (premium).
  personalExamDailyLimit Int?       @map("personal_exam_daily_limit")
  storeProductIdIos      String?    @map("store_product_id_ios")
  storeProductIdAndroid  String?    @map("store_product_id_android")
  isActive               Boolean    @default(true) @map("is_active")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  planId                String             @map("plan_id") @db.Uuid
  provider              PaymentProvider
  status                SubscriptionStatus
  // GÜVENLİK: bir mağaza işlemi (Apple/Google) yalnız BİR abonelik satırı
  // üretir. Unique olmadan eşzamanlı iki doğrulama iki satır yaratıp aynı
  // ödemeyle iki hesaba premium verebiliyordu.
  originalTransactionId String             @unique @map("original_transaction_id")
  currentPeriodEnd      DateTime?          @map("current_period_end")
  autoRenew             Boolean            @default(true) @map("auto_renew")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@map("subscriptions")
}

// Türetilmiş erişim — hızlı kontrol (SubscriptionGuard buradan okur).
model Entitlement {
  userId               String    @id @map("user_id") @db.Uuid
  isPremium            Boolean   @default(false) @map("is_premium")
  validUntil           DateTime? @map("valid_until")
  sourceSubscriptionId String?   @map("source_subscription_id") @db.Uuid
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("entitlements")
}

// Freemium günlük limit — sunucu-taraflı sayaç.
model DailyUsage {
  userId             String   @map("user_id") @db.Uuid
  usageDate          DateTime @map("usage_date") @db.Date
  /// Ücretsiz plan KOTASI: yalnız kotaya tabi modların (practice/daily/review)
  /// yeni cevapları. Deneme/exam muaf — halka/aktiflik için totalAnswered.
  questionsAnswered  Int      @default(0) @map("questions_answered")
  /// Günün TÜM yeni cevapları (deneme dahil): halka, aktif gün, tempo, şerit
  /// (Doc 48 A9). Kota kararında KULLANILMAZ.
  totalAnswered      Int      @default(0) @map("total_answered")
  dailyLimit         Int      @map("daily_limit")
  // AI açıklama hakkı (Doc 24 §11: free günde 3, premium sınırsız).
  aiExplanationsUsed Int      @default(0) @map("ai_explanations_used")
  /// Günün çalışma süresi, saniye (Doc 49 S1-D): cevap süreleri (cevap başına
  /// ≤10 dk) + okuyucu ilerleme kayıtlarının `seconds` alanı. Koç "bugün 12 dk".
  studySeconds       Int      @default(0) @map("study_seconds")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, usageDate])
  @@map("daily_usage")
}

// ─────────────────────────────────────────────
// Learning — Quiz oturumları (Doc 6 §4.3)
// ─────────────────────────────────────────────

/// Randevulu canlı deneme (Doc 18) — eski ekip_sinav'ın modern karşılığı.
/// Küresel zaman penceresi: startAt..startAt+durationMinutes (herkese aynı).
model Exam {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                 String
  description           String?
  /// Takvimli: pencere açılışı. Serbest: yayın anı (görünürlük başlangıcı).
  startAt               DateTime      @map("start_at")
  durationMinutes       Int           @map("duration_minutes")
  /// Denemeler V2 (Doc 50 §2.1). Varsayılan takvimli: eski kayıtlar davranış değiştirmez.
  publishMode           ExamPublishMode @default(takvimli) @map("publish_mode")
  /// Takvimlide pencere kapanışı (açıkça yazılır; sonuçlar bu anda açıklanır).
  /// Serbestte NULL = süresiz; doluysa "yeni çözüme kapanış".
  endAt                 DateTime?     @map("end_at")
  difficulty            ExamDifficulty?
  /// Denemenin sınav türü: ders dağılımı (ExamSection) ve otomatik doldurma bundan.
  examTypeId            String?       @map("exam_type_id") @db.Uuid
  isPremium             Boolean       @default(false) @map("is_premium") // eski kredi yerine (Doc 18 karar 2)
  /// RESMÎ çözümde anlık geri bildirim (şıkka basınca doğru/yanlış + açıklama,
  /// cevap kilitlenir). Tekrar çözümde her zaman açıktır. Varsayılan KAPALI.
  liveAnswerReveal      Boolean       @default(false) @map("live_answer_reveal")
  questionsOpenAfterEnd Boolean       @default(true) @map("questions_open_after_end")
  /// Takvimli pencere kapanınca "Pratik olarak çöz" açık mı (Doc 50). Eski
  /// archiveOpenAfterEnd'in yerini aldı; serbestte anlamsız (tekrar çözüm zaten var).
  practiceAfterEnd      Boolean       @default(true) @map("practice_after_end")
  /// Takvimli: 1 gün ve 1 saat önce hatırlatma; sonuç açıklandı bildirimi.
  remindEnabled         Boolean       @default(true) @map("remind_enabled")
  /// Yük planı (Doc 50 §5): yayınla → cevapsız soru paketi burada; start DB'ye yalnız oturum yazar.
  questionPack          Json?         @map("question_pack")
  questionPackBuiltAt   DateTime?     @map("question_pack_built_at")
  /// Takvimli sıralama donma anı (exam_rankings yazıldı).
  rankingsComputedAt    DateTime?     @map("rankings_computed_at")
  status                ContentStatus @default(draft)
  sortOrder             Int           @default(0) @map("sort_order")
  createdBy             String?       @map("created_by") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")

  examType        ExamType?      @relation(fields: [examTypeId], references: [id])
  questions       ExamQuestion[]
  sessions        QuizSession[]
  /// Çıkmış sınav (Doc 36) çözümleri: PastExam'e bağlı Exam'in tekrarlanabilir oturumları.
  archiveSessions QuizSession[]  @relation("ArchiveExam")
  rankings        ExamRanking[]
  adjustments     ExamQuestionAdjustment[]
  reminders       ExamReminder[]
  /// Doluysa bu Exam bir çıkmış sınavın motor kaydıdır (Doc 36) — deneme
  /// listesinde görünmez. Yabancı anahtar PastExam tarafındadır.
  pastExam        PastExam?

  @@index([status, startAt])
  @@index([status, publishMode, endAt])
  @@map("exams")
}

/// Donmuş/materialize sıralama (Doc 50 §2.3). Takvimlide pencere kapanınca bir
/// kez yazılır; serbestte canlı sorgu (bkz. exams.service.leaderboard).
model ExamRanking {
  examId          String   @map("exam_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  rank            Int
  score           Decimal  @db.Decimal(5, 2)
  wrongCount      Int      @map("wrong_count")
  durationSeconds Int      @map("duration_seconds")
  submittedAt     DateTime @map("submitted_at")
  computedAt      DateTime @default(now()) @map("computed_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([examId, userId])
  @@index([examId, rank])
  @@map("exam_rankings")
}

/// Soru iptali (Doc 50 §2.3): puanlama tek fonksiyonda bu tabloyu okur.
model ExamQuestionAdjustment {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId     String               @map("exam_id") @db.Uuid
  questionId String               @map("question_id") @db.Uuid
  action     ExamAdjustmentAction
  reason     String
  actorId    String               @map("actor_id") @db.Uuid
  createdAt  DateTime             @default(now()) @map("created_at")
  revertedAt DateTime?            @map("reverted_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, revertedAt])
  @@map("exam_question_adjustments")
}

/// Hatırlatma kuyruğu (Doc 50 §2.3). "Hatırlat" düğmesi satır açar; cron gönderir.
model ExamReminder {
  examId  String           @map("exam_id") @db.Uuid
  userId  String           @map("user_id") @db.Uuid
  kind    ExamReminderKind
  sentAt  DateTime?        @map("sent_at")
  createdAt DateTime       @default(now()) @map("created_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([examId, userId, kind])
  @@index([examId, kind, sentAt])
  @@map("exam_reminders")
}

/// Teslim sonrası AĞIR iş kuyruğu (Doc 50 §5-3): ilerleme/seri/rozet güncellemesi
/// Pazar 21:00 yığılmasında kritik yoldan çıkar; cron 50'şer işler.
model ExamFinalizeJob {
  sessionId   String    @id @map("session_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([processedAt, createdAt])
  @@map("exam_finalize_jobs")
}

/// Denemenin sabit soru seti. questionVersionId YAYIN ANINDA sabitlenir —
/// soru sonradan güncellense bile deneme ve geçmiş sonuçlar bozulmaz (Doc 18 §6).
model ExamQuestion {
  examId            String @map("exam_id") @db.Uuid
  questionId        String @map("question_id") @db.Uuid
  questionVersionId String @map("question_version_id") @db.Uuid
  sortOrder         Int    @map("sort_order")

  exam            Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  question        Question        @relation(fields: [questionId], references: [id])
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id])

  @@id([examId, questionId])
  @@map("exam_questions")
}

model QuizSession {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String            @map("user_id") @db.Uuid
  mode                   QuizMode
  topicId                String?           @map("topic_id") @db.Uuid
  // Deneme sınavı kapsamı: ders geneli (konular karışık) — topicId yerine.
  courseId               String?           @map("course_id") @db.Uuid
  /// Seçili mevzuat turu (1 Eki 2026, kullanıcı talebi): tek konu ile tüm ders
  /// arasındaki kapsam — kullanıcının seçtiği konulardan dengeli karışık tur.
  /// Dolu ise topicId/courseId NULL'dur. Geçmiş etiketi ve "aynı seçimle yeni
  /// tur" için saklanır; devam etme questionOrder ile zaten bağımsız çalışır.
  topicIds               String[]          @default([]) @map("topic_ids") @db.Uuid
  // Deneme (Doc 18 → Doc 50): katılım = bu oturum. Tekillik yalnız RESMÎ çözümde:
  // kısmi tekil indeks (user_id, exam_id) WHERE attempt_role='official' (migration SQL).
  examId                 String?           @map("exam_id") @db.Uuid
  /// Deneme çözümünün rolü (Doc 50 §2.2); yalnız mode=deneme oturumlarında dolu.
  attemptRole            AttemptRole?      @map("attempt_role")
  /// Oturum nasıl kapandı (Doc 50 §3): teslim ya da süre dolumu.
  closedReason           SessionClosedReason? @map("closed_reason")
  /// Mutlak son tarih (sunucu saati). Serbest: startedAt + süre; takvimli:
  /// min(startedAt + süre, exam.endAt). Süre denetimi bunu esas alır.
  deadlineAt             DateTime?         @map("deadline_at")
  /// Soru iptali sonrası yeniden puanlama izi (Doc 50 §2.3): "Netin X'ten Y'ye çıktı".
  previousScore          Decimal?          @map("previous_score") @db.Decimal(5, 2)
  scoreUpdatedAt         DateTime?         @map("score_updated_at")
  /// ÇIKMIŞ SINAV (Doc 36) çözümü: PastExam'e bağlı Exam'in tekrarlanabilir oturumu.
  /// Denemelerde (Doc 50) kullanılmaz; orada examId + attemptRole='practice'.
  archiveExamId          String?           @map("archive_exam_id") @db.Uuid
  status                 QuizSessionStatus @default(in_progress)
  totalQuestions         Int               @map("total_questions")
  correctCount           Int               @default(0) @map("correct_count")
  wrongCount             Int               @default(0) @map("wrong_count")
  blankCount             Int               @default(0) @map("blank_count")
  score                  Decimal?          @db.Decimal(5, 2)
  durationSeconds        Int?              @map("duration_seconds")
  // Deneme sınavı süresi (sn) — exam modunda dolu; sunucu aşımı reddeder.
  plannedDurationSeconds Int?              @map("planned_duration_seconds")
  // Seçilen soruların sürüm id sırası (JSON dizi) — devam/kaldığı yerden (Doc 27).
  questionOrder          Json?             @map("question_order")
  /// Kişisel deneme oturumu mu (Doc 46): hedef sınavın müfredat ağırlıklarıyla
  /// kurulan, sıralamaya girmeyen set. Ücretsiz planda günde 1 hak — sayım bu
  /// alandan gider. Örtük çıkarım (mode=exam + dört alan NULL) kırılgandı.
  personalExam           Boolean           @default(false) @map("personal_exam")
  /// Seansın geliş kanalı ("notif" = bildirim derin bağlantısı) — ölçüm.
  source                 String?
  startedAt              DateTime          @default(now()) @map("started_at")
  completedAt            DateTime?         @map("completed_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  archiveExam Exam?        @relation("ArchiveExam", fields: [archiveExamId], references: [id])
  topic       Topic?       @relation(fields: [topicId], references: [id])
  course      Course?      @relation(fields: [courseId], references: [id])
  exam        Exam?        @relation(fields: [examId], references: [id])
  answers     QuizAnswer[]

  // Tekillik kısmi indeksle (migration SQL): yalnız resmî çözüm bir kezdir.
  @@index([userId, examId])
  @@index([userId])
  @@index([examId, status])
  @@index([examId, attemptRole, status])
  // Günlük kişisel deneme hakkının sayımı.
  @@index([userId, personalExam, startedAt])
  @@map("quiz_sessions")
}

/// Kullanıcı soru hata bildirimi (eski sistemdeki question_reports'un sağlıklı hali).
/// Panelde kuyruğa düşer; içerik kalite döngüsünün kullanıcı ayağı.
model QuestionReport {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String       @map("question_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  message    String
  status     ReportStatus @default(open)
  resolvedBy String?      @map("resolved_by") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")
  resolvedAt DateTime?    @map("resolved_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([questionId])
  @@map("question_reports")
}

enum ReportStatus {
  open
  resolved
  dismissed
}

model QuizAnswer {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  questionVersionId String   @map("question_version_id") @db.Uuid // çözülen tam sürüm sabitlenir (Doc 6 §5)
  selectedOptionId  String?  @map("selected_option_id") @db.Uuid // boş = null
  isCorrect         Boolean? @map("is_correct")
  answeredAt        DateTime @default(now()) @map("answered_at")
  timeSpentMs       Int?     @map("time_spent_ms")
  /// "Emin değilim" bayrağı (Doc 49 S1-C) — denemede kalıcı; sonuç ekranında listelenir.
  flagged           Boolean  @default(false)

  session QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
  // Tazelik seçimi: "bu kullanıcı bu soruyu çözdü mü" sorgusu question_id
  // üzerinden tarar — indekssiz her seans başlangıcında tam tablo taraması.
  @@index([questionId])
  @@map("quiz_answers")
}

// ─────────────────────────────────────────────
// Progress & Review (Doc 6 §4.4)
// ─────────────────────────────────────────────

model UserTopicProgress {
  userId         String   @map("user_id") @db.Uuid
  topicId        String   @map("topic_id") @db.Uuid
  solvedCount    Int      @default(0) @map("solved_count")
  correctCount   Int      @default(0) @map("correct_count")
  mastery        Decimal  @default(0) @db.Decimal(4, 3) // 0-1, zayıf konu tespiti
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id])

  @@id([userId, topicId])
  @@map("user_topic_progress")
}

model UserStats {
  userId        String   @id @map("user_id") @db.Uuid
  totalSolved   Int      @default(0) @map("total_solved")
  totalCorrect  Int      @default(0) @map("total_correct")
  totalSessions Int      @default(0) @map("total_sessions")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model Streak {
  userId          String    @id @map("user_id") @db.Uuid
  currentStreak   Int       @default(0) @map("current_streak")
  longestStreak   Int       @default(0) @map("longest_streak")
  lastActiveDate  DateTime? @map("last_active_date") @db.Date
  // Seri sigortası (Doc 24 §7.2, Doc 26 §5): kaçan TEK gün affedilir.
  // Haftalık hak: free 1, premium 3. Hafta = Pzt başlangıçlı UTC (snapshot konv.).
  freezeWeekStart DateTime? @map("freeze_week_start") @db.Date
  freezesUsed     Int       @default(0) @map("freezes_used")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

model Bookmark {
  userId     String   @map("user_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@map("bookmarks")
}

model WrongAnswer {
  userId      String    @map("user_id") @db.Uuid
  questionId  String    @map("question_id") @db.Uuid
  lastWrongAt DateTime  @default(now()) @map("last_wrong_at")
  wrongCount  Int       @default(1) @map("wrong_count")
  resolvedAt  DateTime? @map("resolved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@map("wrong_answers")
}

/// Aralıklı tekrar hafızası (Doc 49 S1-A, 16 Eki 2026). SM-2 sadeleştirilmiş: her
/// cevapta güncellenir (boş cevap hariç; deneme dahil — bilgi bilgidir). WrongAnswer
/// KORUNUR (koç sayacı, ücretsiz 7 gün penceresi); burası "ne zaman tekrar" sorusunu
/// cevaplar. Algoritma: quiz/srs.ts (saf fonksiyon, spec'li).
model QuestionReview {
  userId         String   @map("user_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  ease           Decimal  @default(2.5) @db.Decimal(3, 2)
  intervalDays   Int      @default(0) @map("interval_days")
  reps           Int      @default(0)
  lapses         Int      @default(0)
  dueAt          DateTime @map("due_at")
  lastReviewedAt DateTime @default(now()) @map("last_reviewed_at")
  lastResult     Boolean  @map("last_result")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([userId, dueAt])
  @@map("question_reviews")
}

// ── Mevzuat ↔ soru (Doc 49 S1-B, `10-s1-veri-katmani.md` §1.2) ──

/// Soru–madde bağı: `primary` sorunun dayandığı madde, `related` yan dayanak.
enum QuestionArticleRelation {
  primary
  related
}

/// Bağın kaynağı: eski `Question.articleNo` etiketinden türetildi / editör elle
/// bağladı / betik (madde-oner vb.) önerdi. Güven ayrımı için saklanır.
enum QuestionArticleSource {
  legacy_article_no
  editor
  script
}

/// Soru ↔ madde N:N. `Question.articleNo` KALIR (atlas onu okur); yeni uçlar
/// bu tabloyu okur. Backfill: `s1-question-article-backfill.ts`.
model QuestionArticle {
  questionId   String                  @map("question_id") @db.Uuid
  lawArticleId String                  @map("law_article_id") @db.Uuid
  relation     QuestionArticleRelation @default(primary)
  source       QuestionArticleSource   @default(legacy_article_no)
  createdAt    DateTime                @default(now()) @map("created_at")

  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  lawArticle LawArticle @relation(fields: [lawArticleId], references: [id], onDelete: Cascade)

  @@id([questionId, lawArticleId])
  @@index([lawArticleId])
  @@map("question_articles")
}

/// Madde metni sürümü. `LawArticle.text` her zaman GÜNCEL sürümü yansıtır;
/// burada tarihçe tutulur (S2: metin değişince yeni sürüm + bağlı soruların
/// yeniden incelemesi). Backfill: yayımlı her maddenin bugünkü metni = sürüm 1.
/// `effectiveFrom` bilinmiyorsa NULL — uydurulmaz (güven ilkesi).
model LawArticleVersion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lawArticleId  String    @map("law_article_id") @db.Uuid
  versionNo     Int       @map("version_no")
  text          String
  sourceName    String    @map("source_name")
  sourceUrl     String?   @map("source_url")
  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  verifiedAt    DateTime? @map("verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  lawArticle LawArticle @relation(fields: [lawArticleId], references: [id], onDelete: Cascade)

  @@unique([lawArticleId, versionNo])
  @@map("law_article_versions")
}

// ── Soru notu, kişisel liste (Doc 49 S1-C, `10-s1-veri-katmani.md` §1.3) ──

/// Kullanıcının soruya kişisel notu (≤2000 karakter; DTO sınırlar).
model QuestionNote {
  userId     String   @map("user_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  text       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@map("question_notes")
}

/// Kişisel soru listesi. Ücretsiz: 3 liste × 50 soru (plan.constants); premium sınırsız.
model UserList {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items UserListItem[]

  @@index([userId, sortOrder])
  @@map("user_lists")
}

model UserListItem {
  listId     String   @map("list_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at")

  list     UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([listId, questionId])
  @@index([listId, addedAt])
  @@map("user_list_items")
}

// ── Haftalık plan (Doc 49 S1-E, `10-s1-veri-katmani.md` §1.6) — şema şimdi, servis F8 ──

enum StudyPlanStatus {
  active
  archived
}

enum StudyPlanItemStatus {
  pending
  done
  skipped
}

/// Plan kalemi türü (Doc 49/12 F8-A): konu çalışması, tekrar (SRS/yanlış), deneme.
enum StudyPlanItemKind {
  topic
  review
  mock
}

/// Kullanıcının haftalık çalışma planı. Kullanıcı başına en çok bir `active`
/// plan (servis kuralı; revize = eskisi archived + yeni satır). Üretim algoritması F8.
model StudyPlan {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  examDate      DateTime?       @map("exam_date") @db.Date
  weeklyMinutes Int             @map("weekly_minutes")
  status        StudyPlanStatus @default(active)
  createdAt     DateTime        @default(now()) @map("created_at")
  revisedAt     DateTime?       @map("revised_at")
  /// Planın kurulduğu hedef sınav türü (müfredat/ağırlık kaynağı). Kullanıcı
  /// sınav türünü değiştirirse plan yeniden kurulur (F8-A §3).
  examTypeId    String?         @map("exam_type_id") @db.Uuid
  /// Ufuk: sınav tarihi yoksa yuvarlanan 12 hafta; tarih varsa sınava kalan
  /// hafta (tavan 26). Okuma ucu evreyi buradan ve examDate'ten türetir.
  horizonWeeks  Int             @default(12) @map("horizon_weeks")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  examType ExamType?       @relation(fields: [examTypeId], references: [id], onDelete: SetNull)
  items    StudyPlanItem[]

  @@index([userId, status])
  @@map("study_plans")
}

/// Haftalık plan kalemi: hafta başı (Pazartesi) + konu + hedef/gerçekleşen.
model StudyPlanItem {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId          String              @map("plan_id") @db.Uuid
  weekStart       DateTime            @map("week_start") @db.Date
  /// `topic` kalemlerinde dolu; `review`/`mock` kalemlerinde NULL (F8-A §4).
  topicId         String?             @map("topic_id") @db.Uuid
  kind            StudyPlanItemKind   @default(topic)
  targetQuestions Int                 @default(0) @map("target_questions")
  targetMinutes   Int                 @default(0) @map("target_minutes")
  doneQuestions   Int                 @default(0) @map("done_questions")
  /// Türetilmiş: floor(doneSeconds / 60) — aynı UPDATE'te yazılır (istemci sözleşmesi dakika).
  doneMinutes     Int                 @default(0) @map("done_minutes")
  /// Gerçek sayaç (saniye): 45 sn'lik cevaplar dakikaya yuvarlanıp şişmesin.
  doneSeconds     Int                 @default(0) @map("done_seconds")
  status          StudyPlanItemStatus @default(pending)

  plan  StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  topic Topic?    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([planId, weekStart])
  @@map("study_plan_items")
}

/// AI açıklama önbelleği (Doc 24 §4 Faz 2): aynı soru+şık için BİR KEZ üretilir,
/// herkese servis edilir — maliyet soru başına tek seferdir. İçerik sürüme
/// bağlıdır (soru düzenlenirse yeni sürüm = yeni önbellek satırı).
model AiExplanation {
  questionVersionId String   @map("question_version_id") @db.Uuid
  /// Kullanıcının seçtiği şık — çeldirici analizi şıkka özeldir.
  chosenOptionId    String   @map("chosen_option_id") @db.Uuid
  text              String
  model             String
  createdAt         DateTime @default(now()) @map("created_at")

  @@id([questionVersionId, chosenOptionId])
  @@map("ai_explanations")
}

/// Uygulama ayarları (anahtar-değer) — admin panelden yönetilir.
/// Örn. show_question_source: kaynak etiketi kullanıcıya gösterilsin mi.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ─────────────────────────────────────────────
// Gamification + Kişisel Koç (Doc 19)
// ─────────────────────────────────────────────

/// Rozet kataloğu — seed ile yüklenir; kazanım kuralı kind+threshold ile
/// deterministiktir (örn. streak/7 = "7 Gün Seri").
model Badge {
  key         String    @id // streak_7, solved_100, first_exam…
  name        String
  description String
  kind        BadgeKind
  threshold   Int // eşik: gün / soru / deneme sayısı / % doğruluk
  sortOrder   Int       @default(0) @map("sort_order")

  earners UserBadge[]

  @@map("badges")
}

enum BadgeKind {
  streak // currentStreak >= threshold
  solved // totalSolved >= threshold
  exam // tamamlanan deneme sayısı >= threshold
  accuracy // doğruluk %'si >= threshold (min 100 soru sonrası)
}

model UserBadge {
  userId   String   @map("user_id") @db.Uuid
  badgeKey String   @map("badge_key")
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeKey], references: [key])

  @@id([userId, badgeKey])
  @@map("user_badges")
}

/// Haftalık konu ustalığı fotoğrafı — trend kartları ("bu hafta %12 arttı")
/// ve ileride AI koç analizleri için (Doc 19 §2.1). weekStart = Pazartesi.
model TopicMasterySnapshot {
  userId    String   @map("user_id") @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  weekStart DateTime @map("week_start") @db.Date
  mastery   Decimal  @db.Decimal(4, 3)
  solved    Int      @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id])

  @@id([userId, topicId, weekStart])
  @@index([userId, weekStart])
  @@map("topic_mastery_snapshots")
}

// ─────────────────────────────────────────────
// Migration (kullanıcı göçü — paem705 kaynak)
// ─────────────────────────────────────────────

model LegacyUserMap {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  newUserId             String       @map("new_user_id") @db.Uuid
  legacySource          LegacySource @map("legacy_source")
  legacyId              String       @map("legacy_id")
  legacyEmail           String       @map("legacy_email")
  migratedAt            DateTime     @default(now()) @map("migrated_at")
  passwordResetRequired Boolean      @default(true) @map("password_reset_required")

  @@index([newUserId])
  @@index([legacyEmail])
  @@map("legacy_user_map")
}

// ─────────────────────────────────────────────
// Çıkmış sınavlar (Doc 36)
// ─────────────────────────────────────────────

/// Sınavın niteliği. `resmi` = kurumun yayımladığı gerçek kitapçık.
/// `analiz` = sınav yayımlanmadı; elimizde aday hatırlatmasından çıkarılmış
/// konu dağılımı ve o konulardan bizim yazdığımız sorular var. İkisi
/// kullanıcıya AYRI rozetle gösterilir (Doc 36 §1) — karıştırmak, bankanın
/// "gerçek çıkmış soru" güvenini harcamak olur.
enum PastExamKind {
  resmi
  analiz
}

/// Bir çıkmış sınav dönemi (PAEM 9, PAEM 8, ...).
model PastExam {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// URL parçası: "paem-9-2025" → /paem-cikmis-sorular/paem-9-2025
  slug          String        @unique
  name          String
  institution   String        @map("institution")
  /// Dönem numarası (PAEM 9 → 9). Sıralama ve başlık üretiminde kullanılır.
  term          Int?
  heldOn        DateTime?     @map("held_on") @db.Date
  kind          PastExamKind
  /// Vitrin sayfasındaki tanıtım metni.
  summary       String?
  /// Sınavdaki toplam soru sayısı — `analiz` türünde sorular bankada yoktur,
  /// dağılım yine de bu sayı üzerinden anlatılır.
  questionCount Int?          @map("question_count")
  /// Konu analizi: ders ve kanun kırılımı, kaynak ve güvenilirlik notu.
  /// `analiz` türü sınavların TEK içeriği budur; resmî sınavlarda sorulardan
  /// da hesaplanabilir ama sayfa tek yerden okusun diye burada saklanır.
  analysis      Json?
  /// Dönem Premium'a özel mi (7 Eyl 2026 kararı).
  ///
  /// Anahtar burada, gizli `Exam` kaydında DEĞİL: bir dönemin iki modu var
  /// (sınav gibi çöz + çalışma modu) ve `Exam.isPremium` yalnız birincisini
  /// kapatıyordu — aday 100 soruyu cevaplarıyla okumaya devam edebiliyordu.
  /// Tek karar noktası olmalı. Public SEO sayfası bundan ETKİLENMEZ: orası
  /// huninin girişi, paywall'a alınmaz.
  isPremium     Boolean       @default(false) @map("is_premium")
  /// Sınav gibi çözme deneyimi mevcut deneme motorundan gelir.
  examId        String?       @unique @map("exam_id") @db.Uuid
  exam          Exam?         @relation(fields: [examId], references: [id])
  status        ContentStatus @default(draft)
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  questions PastExamQuestion[]

  @@index([status, sortOrder])
  @@map("past_exams")
}

/// Sınavdaki soru ve o sınava özgü bilgileri.
model PastExamQuestion {
  pastExamId String  @map("past_exam_id") @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  /// Kitapçıktaki sıra (A grubu esas alınır).
  orderNo    Int     @map("order_no")
  /// Sınavda İPTAL edilmiş soru: gösterilir ama puanlanmaz.
  cancelled  Boolean @default(false)
  /// Public SEO sayfasında tam metniyle görünen soru (dönem başına ~20).
  publicly   Boolean @default(false) @map("publicly_visible")

  pastExam PastExam @relation(fields: [pastExamId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@id([pastExamId, questionId])
  @@unique([pastExamId, orderNo])
  @@index([questionId])
  @@map("past_exam_questions")
}

// ─────────────────────────────────────────────
// E-posta modülü (docs/47-eposta-ses/02-tasarim.md §3)
// Toplu bilgilendirme/pazarlama postaları Amazon SES ile. Bastırmanın tek
// kaynağı SES hesap listesidir; email_contacts.status onun aynasıdır.
// ─────────────────────────────────────────────

enum EmailContactSource {
  live_user // yeni sistemin kullanıcısı (users tablosu)
  legacy_paem705 // eski paem705 dökümü; yeni sistemde hesabı yok
  manual // admin elle ekledi
}

enum EmailContactStatus {
  subscribed
  unsubscribed // kişi kendi çıktı (hepsinden)
  bounced // kalıcı bounce (SES hesap listesinde)
  complained // spam işareti (SES hesap listesinde)
  suppressed // üst üste geçici bounce ya da admin kararı
}

enum EmailTopic {
  duyuru // ürün/uygulama bilgilendirmesi
  kampanya // pazarlama
}

enum EmailCampaignStatus {
  draft
  test_sent
  scheduled
  sending
  paused
  completed
  cancelled
  failed
}

enum EmailSendStatus {
  queued
  claimed // işçi aldı; SES yanıtı henüz yok (10 dk'dan eskiyse "belirsiz")
  sent
  delivered
  bounced
  complained
  failed
  skipped // gönderim anında kişi artık abone değildi
}

enum EmailEventType {
  send
  delivery
  bounce
  complaint
  reject
  delivery_delay
  click
  rendering_failure
}

model EmailContact {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Küçük harfe normalize edilmiş adres.
  email             String             @unique
  userId            String?            @map("user_id") @db.Uuid
  displayName       String?            @map("display_name")
  source            EmailContactSource
  /// legacy_paem705 için eski kayıt yılı (kademeli gönderim).
  legacyYear        Int?               @map("legacy_year")
  status            EmailContactStatus @default(subscribed)
  consentAt         DateTime?          @map("consent_at")
  consentSource     String?            @map("consent_source")
  unsubscribedAt    DateTime?          @map("unsubscribed_at")
  unsubscribeReason String?            @map("unsubscribe_reason")
  /// 32 bayt rastgele, base64url. Çıkış/tercih bağlantısının tek kimliği.
  unsubscribeToken  String             @unique @map("unsubscribe_token")
  /// Serbest etiketler (ör. brevo_first300); kitle süzgecinde `tags` ile seçilir.
  tags              String[]           @default([])
  softBounceCount   Int                @default(0) @map("soft_bounce_count")
  lastSentAt        DateTime?          @map("last_sent_at")
  lastEventAt       DateTime?          @map("last_event_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user        User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  preferences EmailTopicPreference[]
  sends       EmailSend[]

  @@index([status])
  @@index([source, legacyYear])
  @@index([userId])
  @@map("email_contacts")
}

/// Satır yoksa konu için varsayılan ABONE. "Hepsinden çık" = contact.status.
model EmailTopicPreference {
  contactId  String     @map("contact_id") @db.Uuid
  topic      EmailTopic
  subscribed Boolean    @default(true)
  updatedAt  DateTime   @updatedAt @map("updated_at")

  contact EmailContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([contactId, topic])
  @@map("email_topic_preferences")
}

model EmailCampaign {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  topic             EmailTopic
  subject           String
  previewText       String?             @map("preview_text")
  fromName          String              @map("from_name")
  fromEmail         String              @map("from_email")
  replyTo           String?             @map("reply_to")
  bodyMarkdown      String              @map("body_markdown")
  /// Gönderim başlarken dondurulan HTML; sonradan gövde değişse de gidenler budur.
  htmlSnapshot      String?             @map("html_snapshot")
  status            EmailCampaignStatus @default(draft)
  /// {source[], legacyYears[], excludeCampaignIds[]} — §5
  audience          Json                @default("{}")
  dailyCap          Int                 @default(150) @map("daily_cap")
  sendRatePerSec    Decimal             @default(1) @map("send_rate_per_sec") @db.Decimal(6, 2)
  scheduledAt       DateTime?           @map("scheduled_at")
  startedAt         DateTime?           @map("started_at")
  completedAt       DateTime?           @map("completed_at")
  pausedReason      String?             @map("paused_reason")
  createdBy         String              @map("created_by") @db.Uuid
  // Olaylardan güncellenen önbellek sayaçları
  targetedCount     Int                 @default(0) @map("targeted_count")
  sentCount         Int                 @default(0) @map("sent_count")
  deliveredCount    Int                 @default(0) @map("delivered_count")
  bouncedCount      Int                 @default(0) @map("bounced_count")
  complainedCount   Int                 @default(0) @map("complained_count")
  unsubscribedCount Int                 @default(0) @map("unsubscribed_count")
  /// Tekil tıklayan alıcı (kendi yönlendirme ucumuz, 4 Eki 2026; SES CLICK kapalı).
  clickedCount      Int                 @default(0) @map("clicked_count")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  sends EmailSend[]

  @@index([status])
  @@map("email_campaigns")
}

/// Kampanya × kişi. Tekillik ve çökme kurtarması burada (§4).
model EmailSend {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId     String          @map("campaign_id") @db.Uuid
  contactId      String          @map("contact_id") @db.Uuid
  /// Gönderim anındaki adres (kişi sonradan değişse de iz kalır).
  email          String
  status         EmailSendStatus @default(queued)
  sesMessageId   String?         @unique @map("ses_message_id")
  attempts       Int             @default(0)
  claimedAt      DateTime?       @map("claimed_at")
  sentAt         DateTime?       @map("sent_at")
  lastEventAt    DateTime?       @map("last_event_at")
  /// İlk tıklama; kampanyanın tekil tıklama sayacı buradan artar.
  firstClickedAt DateTime?       @map("first_clicked_at")
  error          String?
  createdAt      DateTime        @default(now()) @map("created_at")

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  EmailContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  events   EmailEvent[]

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@map("email_sends")
}

/// Ham SES olayı (SNS). 90 günden eskiler silinir; kampanya sayaçları kalır.
model EmailEvent {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sesMessageId String         @map("ses_message_id")
  sendId       String?        @map("send_id") @db.Uuid
  type         EmailEventType
  /// bounce: Permanent/Transient + bounceSubType; complaint: feedback türü
  subtype      String?
  recipient    String
  /// Kırpılmış: tanılama kodu, zaman damgaları. Kullanıcı aracısı/IP tutulmaz.
  payload      Json?
  occurredAt   DateTime       @map("occurred_at")
  receivedAt   DateTime       @default(now()) @map("received_at")

  send EmailSend? @relation(fields: [sendId], references: [id], onDelete: SetNull)

  @@unique([sesMessageId, type, occurredAt])
  @@index([type, occurredAt])
  @@map("email_events")
}

/// Günün odağı (Doc 48 A5; Doc 25 §5) — GEÇİCİ: yalnız `day` günü geçerli,
/// ertesi gün okunurken koça döner. Kullanıcı başına tek satır.
enum FocusKind {
  coach
  course
  topic
  wrongs
}

model DailyFocus {
  userId    String    @id @map("user_id") @db.Uuid
  day       DateTime  @db.Date
  kind      FocusKind
  courseId  String?   @map("course_id") @db.Uuid
  topicId   String?   @map("topic_id") @db.Uuid
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  topic  Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@map("daily_focus")
}
