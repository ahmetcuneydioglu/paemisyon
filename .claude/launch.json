{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:dev"
      ],
      "cwd": "apps/api",
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "apps/admin",
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "apps/web",
      "port": 3002
    },
    {
      "name": "api-e2e",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3005",
        "npm",
        "run",
        "start:dev"
      ],
      "cwd": "apps/api",
      "port": 3005
    },
    {
      "name": "web-e2e",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_API_BASE_URL=http://localhost:3005/api/v1",
        "npm",
        "run",
        "dev"
      ],
      "cwd": "apps/web",
      "port": 3002
    }
  ]
}