    {
     "id": "04e8c4c3-b3b5-4bc3-9ac1-2a7c911ecd11",
     "label": "C",
     "text": "Devlet memurları eğitimi genel planı, Cumhurbaşkanı kararıyla yürürlüğe konulur.",
     "isCorrect": false
    },
    {
     "id": "9f389018-1af0-43ed-878c-99f89dc93beb",
     "label": "D",
     "text": "Devlet memurları, yabancı memleketlerin hizmetle ilgili kurumlarında veya yetiştirme-eğitim merkezlerinde yetiştirilebilirler.",
     "isCorrect": false
    },
    {
