   "contentHash": "d9a17029d6283c8eba9dc111ec64c6d43a81146005aabc805925f15cc99286b1",
   "createdAt": "2026-07-20T02:05:10.000Z",
   "options": [
    {
     "id": "a5fbf2a4-47f3-4ab7-8f57-424df1347677",
     "label": "A",
     "text": "Temyiz istemi en geç bir ay içinde karara bağlanır.",
     "isCorrect": false
    },
    {
     "id": "0843db46-bd16-44f0-979f-99d70be91b48",
     "label": "B",
     "text": "Temyiz dilekçelerine cevap verme süresi yirmi gündür.",
     "isCorrect": false
    },
    {
     "id": "0ed82807-2c4f-49a9-a2e0-6fedab0b9b6e",
     "label": "C",
     "text": "Temyiz dilekçeleri yedi gün içinde incelenir ve tebliğe çıkarılır.",
     "isCorrect": false
    },
    {
     "id": "442b21ca-3710-483c-bd4c-e69a0c470d84",
     "label": "D",
     "text": "Yürütmenin durdurulması talebine ilişkin olarak verilecek kararlara itiraz edilebilir.",
     "isCorrect": false
    },
    {
     "id": "2ff823cd-23bb-4665-a4fd-d776c1eb1a8a",
     "label": "E",
     "text": "Verilen nihai kararlara karşı tebliğ tarihinden itibaren on beş gün içinde temyiz yoluna başvurulabilir.",
     "isCorrect": true
    }
   ],
   "question": {
    "topic": {
     "name": "2577 İdari Yargılama Usulü Kanunu (İYUK)"
    }
   }
  }
