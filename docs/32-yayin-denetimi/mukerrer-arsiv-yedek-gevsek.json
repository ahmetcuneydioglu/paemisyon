   "sourceLabel": "19 AĞUSTOS 2023 ADALET BAKANLIĞI GYS",
   "contentHash": "b32d71d26d4b8813258a2d418981dcb03895cd359ced5f64a890131c2403de0b",
   "createdAt": "2026-07-20T01:57:19.850Z",
   "options": [
    {
     "id": "0c2b1a22-e60b-4e15-a3b9-39ef7607db2e",
     "label": "A",
     "text": "Genel Kurul, Mahkeme Başkanının veya Başkanın belirleyeceği başkanvekilinin başkanlığında en az on iki üye ile toplanır.",
     "isCorrect": false
    },
    {
     "id": "0626fdf0-8750-449a-a61c-d08520a83529",
     "label": "B",
     "text": "Anayasa değişikliğinde iptale karar verilebilmesi için üye tam sayısının salt çoğunluğunun oyu şarttır.",
     "isCorrect": false
    },
    {
     "id": "bedaf013-7894-409b-b264-b39d3c92ada7",
     "label": "C",
     "text": "Mahkemenin çalışma esasları, bölüm ve komisyonların oluşumu ve işbölümü yönetmelikle düzenlenir.",
     "isCorrect": false
    },
    {
     "id": "ddd27f6e-0e1a-4b82-8c64-ae1c49de3971",
     "label": "D",
     "text": "Mahkeme, gerekli gördüğü hâllerde sözlü açıklamalarını dinlemek üzere ilgilileri ve konu üzerinde bilgisi olanları çağırabilir.",
     "isCorrect": true
    },
    {
     "id": "f0d7a64e-c003-40e9-af33-89ece8727bc0",
     "label": "E",
     "text": "Yüce Divan sıfatıyla yürütülecek yargılamalara bölümlerce bakılır, bireysel başvurular ise Genel Kurulca karara bağlanır.",
     "isCorrect": false
    }
   ],
   "question": {
    "topic": {
     "name": "T.C. Anayasası"
    }
   }
  }
