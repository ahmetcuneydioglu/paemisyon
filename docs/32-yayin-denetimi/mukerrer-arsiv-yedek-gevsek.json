   "createdAt": "2026-07-20T02:21:03.832Z",
   "options": [
    {
     "id": "551c5264-cfab-4b69-b344-18fc46d8e601",
     "label": "A",
     "text": "Kurumlar kendi eğitim ihtiyaçlarını karşılamak üzere eğitim merkezleri açabilirler.",
